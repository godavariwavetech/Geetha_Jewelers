# Copy to ios/fastlane/.env for local runs (never commit .env)
APP_IDENTIFIER=com.geethajewellers.app
TEAM_ID=XXXXXXXXXX
APPLE_ID=you@example.com

# App Store Connect API key (App Store Connect > Users and Access > Integrations > Keys)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=          # base64 of the AuthKey_XXXX.p8 file
ASC_KEY_IS_BASE64=true

# fastlane match (private git repo holding encrypted certs/profiles)
MATCH_GIT_URL=https://github.com/<org>/ios-certificates.git
MATCH_PASSWORD=
MATCH_GIT_BASIC_AUTHORIZATION=   # base64 of "username:personal_access_token"
